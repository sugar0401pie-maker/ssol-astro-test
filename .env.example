# 값은 .env.local(저장소에 올리지 않음)과 Vercel 환경변수에만 넣는다.
# 쏠 웰니스 하우스(app.)·디저트 테스트(quiz.)와 같은 Supabase 프로젝트를 쓴다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# 유료 리포트 결제(토스페이먼츠 결제위젯). 쏘웰라와 같은 가맹점 키를 써도 된다. 라이브 키면 실제로 청구된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 유료 리포트 모델 ID(비우면 스펙 이름 gpt-6.1-sol). OpenAI 대시보드의 정확한 모델 ID로 맞춘다.
REPORT_MODEL=
