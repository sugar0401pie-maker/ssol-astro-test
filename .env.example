# 값은 .env.local(저장소에 올리지 않음)과 Vercel 환경변수에만 넣는다.
# 쏠 웰니스 하우스(app.)·디저트 테스트(quiz.)와 같은 Supabase 프로젝트를 쓴다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# 유료 리포트 결제(토스페이먼츠 결제위젯). 쏘웰라와 같은 가맹점 키를 써도 된다. 라이브 키면 실제로 청구된다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 유료 리포트 모델 ID(비우면 스펙 이름 gpt-6.1-sol). OpenAI 대시보드의 정확한 모델 ID로 맞춘다.
REPORT_MODEL=
# 카카오톡 카드 공유(그림·제목·버튼). 카카오 개발자센터 > 내 애플리케이션 > 앱 키의 'JavaScript 키'(공개돼도 되는 키).
# 플랫폼 > Web에 https://astro.ssolwellnesshouse.com 도메인이 등록돼 있어야 한다. 비우면 기기 공유창으로 보낸다.
NEXT_PUBLIC_KAKAO_JS_KEY=
# 리포트 완성 메일(Resend). 쏘웰라와 같은 Resend 계정 키를 써도 된다. 비우면 메일을 보내지 않는다.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# 구글 애널리틱스 4 측정 ID(G-로 시작, 공개돼도 되는 값). 비우면 GA를 불러오지 않는다.
NEXT_PUBLIC_GA_ID=
# X(트위터) 전환 API 토큰(X 광고 관리자 > 이벤트 관리자 > 수동 설정 > Generate access token). 비우면 서버 전환을 보내지 않는다.
X_PIXEL_TOKEN=
